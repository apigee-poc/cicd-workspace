{
  "info": {
    "_postman_id": "84db09fe-e800-463d-b784-05915eaec361",
    "name": "hello-v1",
    "description": "Functional tests for the hello-v1 proxy. Set baseUrl per environment (local emulator: http://localhost:8998). Run with Newman in CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request in this collection",
          "pm.test(\"Content-Type is application/json\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "happy path",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Body has the expected greeting\", function () {",
              "    pm.expect(pm.response.json().message).to.eql(\"Hello, Rizk!\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/hello?name=Rizk",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "hello"
          ],
          "query": [
            {
              "key": "name",
              "value": "Rizk"
            }
          ]
        }
      },
      "response": []
    },
